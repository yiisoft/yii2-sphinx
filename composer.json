{
    "name": "yiisoft/yii2-sphinx",
    "description": "Sphinx full text search engine extension for the Yii framework",
    "keywords": ["yii2", "sphinx", "active-record", "search", "fulltext"],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2-sphinx/issues",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "source": "https://github.com/yiisoft/yii2-sphinx"
    },
    "authors": [
        {
            "name": "Paul Klimov",
            "email": "klimov.paul@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "yiisoft/yii2": "~2.0.54",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "mspirkov/yii2-rector": "^0.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.6",
        "slevomat/coding-standard": "^8.31",
        "yiisoft/yii2-coding-standards": "~3.0",
        "yiisoft/yii2-gii": "^2.2"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "yii\\sphinx\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs": "./vendor/bin/phpcs && ./vendor/bin/php-cs-fixer check",
        "cs-fix": "./vendor/bin/phpcbf && ./vendor/bin/php-cs-fixer fix",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/phpunit",
        "rector": "./vendor/bin/rector"
    }
}
